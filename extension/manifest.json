{
 "manifest_version":3, "name":"评论工作台 · 多平台评论采集", "version":"0.8.1",
 "description":"按主题检索五个平台的作品，逐篇或连续采集可见评论，在本机整理、追溯回复及导出。",
 "permissions":["activeTab","storage","tabs"],
 "host_permissions":["https://www.douyin.com/*","https://zhuanlan.zhihu.com/*","https://www.zhihu.com/*","https://www.xiaohongshu.com/*","https://weibo.com/*","https://www.weibo.com/*","https://www.bilibili.com/*","https://s.weibo.com/*","https://search.bilibili.com/*","http://127.0.0.1/*"],
 "background":{"service_worker":"bridge.js"},
 "action":{"default_title":"采集当前作品","default_popup":"popup.html"},
 "content_scripts":[{"matches":["https://www.douyin.com/*"],"js":["sites.js","discovery.js","content.js"],"run_at":"document_idle"},
 {"matches":["https://zhuanlan.zhihu.com/*","https://www.zhihu.com/*"],"js":["sites.js","discovery.js","zhihu.js","content.js"],"run_at":"document_idle"},
 {"matches":["https://www.xiaohongshu.com/*"],"js":["sites.js","discovery.js","xhs.js","content.js"],"run_at":"document_idle"},
 {"matches":["https://weibo.com/*","https://www.weibo.com/*"],"js":["sites.js","discovery.js","post-comments.js","weibo.js","content.js"],"run_at":"document_idle"},
 {"matches":["https://www.bilibili.com/*"],"js":["sites.js","discovery.js","post-comments.js","bilibili.js","content.js"],"run_at":"document_idle"},
 {"matches":["https://s.weibo.com/*","https://search.bilibili.com/*"],"js":["sites.js","discovery.js"],"run_at":"document_idle"}]
}
